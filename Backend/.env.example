# Copy this file to ".env" and fill in real values. Never commit the real .env.

# MongoDB connection string (Atlas or local).
MONGODB_URL=mongodb+srv://<user>:<password>@<cluster>/InterviewAuto?retryWrites=true&w=majority

# Google Gemini API key — https://aistudio.google.com/app/apikey
# GEMINI_API_KEY is preferred; AIKey is supported for backward compatibility.
GEMINI_API_KEY=your-gemini-api-key
# Model to use (default: gemini-flash-latest)
GEMINI_MODEL=gemini-flash-latest

# Auth — used to sign/verify JWTs. Use a long random string in production.
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES=7d

# Server port
PORT=3030
